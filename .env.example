# ── App ────────────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=change-me-in-production

# ── Database ───────────────────────────────────────────────────────────────
# Used automatically in development 
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Used in production via Docker Compose (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://dlo:dlo_secret@db:5432/deadletteroffice

POSTGRES_USER=dlo
POSTGRES_PASSWORD=dlo_secret
POSTGRES_DB=deadletteroffice

# ── NVIDIA Nemotron ────────────────────────────────────────────────────────
# Free API key from: https://build.nvidia.com
# Sign up → browse models → Nemotron Super → "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# ── Discord Bot ────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ── Escalation webhook (optional) ──────────────────────────────────────────
# If set, P1 and P2 incidents will POST a JSON payload to this URL
ESCALATION_WEBHOOK_URL=

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO